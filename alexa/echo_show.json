  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "paddingLeft": "${viewport.width < 650 ? 16 : 28}",
        "paddingRight": "${viewport.width < 650 ? 16 : 28}",
        "paddingTop": "${viewport.height < 500 ? 12 : 20}",
        "paddingBottom": "${viewport.height < 500 ? 12 : 20}",
        "items": [
          {
            "type": "Container",
            "width": "100%",
            "height": "${viewport.height < 500 ? 85 : 106}",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "height": "${viewport.height < 500 ? 63 : 78}",
                "items": [
                  {
                    "type": "VectorGraphic",
                    "source": "BindicatorMark",
                    "width": "${viewport.height < 500 ? 90 : 105}",
                    "height": "${viewport.height < 500 ? 61 : 73}",
                    "scale": "best-fit"
                  },
                  {
                    "type": "Container",
                    "width": "${viewport.width < 650 ? 30 : 44}",
                    "height": 1,
                    "items": []
                  },
                  {
                    "type": "Container",
                    "grow": 1,
                    "shrink": 1,
                    "justifyContent": "center",
                    "items": [
                      {
                        "type": "Text",
                        "text": "BINDICATOR",
                        "fontSize": "${viewport.height < 500 ? 28 : 34}",
                        "fontWeight": "bold",
                        "color": "#effaf0",
                        "maxLines": 1
                      },
                      {
                        "type": "Text",
                        "text": "Home lighting & bin collection reminders",
                        "fontSize": "${viewport.height < 500 ? 11 : 14}",
                        "color": "#b3cfbe",
                        "maxLines": 1,
                        "marginTop": 5
                      }
                    ],
                    "marginRight": 12
                  },
                  {
                    "type": "Text",
                    "text": "${payload.binbuddy.status}",
                    "fontSize": "${viewport.height < 500 ? 11 : 13}",
                    "fontWeight": "bold",
                    "color": "#85efad",
                    "maxLines": 1,
                    "marginLeft": 8
                  }
                ]
              },
              {
                "type": "Frame",
                "width": "100%",
                "height": 2,
                "backgroundColor": "#55c48b",
                "marginTop": "${viewport.height < 500 ? 10 : 13}",
                "items": []
              }
            ]
          },
          {
            "type": "Text",
            "text": "NEXT COLLECTION",
            "fontSize": 15,
            "letterSpacing": 1.2,
            "color": "#b3cfbe",
            "marginTop": "${viewport.height < 500 ? 10 : 18}"
          },
          {
            "type": "Text",
            "text": "${payload.binbuddy.dateLabel}",
            "fontSize": "${viewport.height < 500 ? 32 : 40}",
            "fontWeight": "bold",
            "color": "#f1f9f3",
            "maxLines": 2
          },
          {
            "type": "Text",
            "text": "${payload.binbuddy.countdown}",
            "fontSize": 19,
            "color": "#85efad",
            "marginTop": 2
          },
          {
            "type": "Frame",
            "backgroundColor": "#132820",
            "borderColor": "#386b4e",
            "borderWidth": 1,
            "borderRadius": 14,
            "padding": 14,
            "marginTop": "${viewport.height < 500 ? 12 : 20}",
            "items": [
              {
                "type": "Container",
                "width": "100%",
                "height": "100%",
                "items": [
                  {
                    "type": "Sequence",
                    "width": "100%",
                    "height": "100%",
                    "data": "${payload.binbuddy.bins}",
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "alignItems": "center",
                        "height": 101,
                        "items": [
                          {
                            "type": "VectorGraphic",
                            "source": "${data.graphic}",
                            "width": 82,
                            "height": 96,
                            "scale": "best-fit"
                          },
                          {
                            "type": "Text",
                            "text": "${data.title}",
                            "color": "#f1f9f3",
                            "fontSize": "${viewport.height < 500 ? 25 : 29}",
                            "maxLines": 2,
                            "marginLeft": 18
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "height": "${viewport.height < 500 ? (payload.binbuddy.bins.length <= 1 ? 126 : 188) : (payload.binbuddy.bins.length <= 1 ? 146 : 215)}"
          },
          {
            "type": "Text",
            "text": "${payload.binbuddy.detail}",
            "fontSize": 17,
            "color": "#b3cfbe",
            "maxLines": 2,
            "marginTop": "${viewport.height < 500 ? 12 : 18}"
          },
          {
            "type": "TouchWrapper",
            "id": "binsOutButton",
            "disabled": "${!payload.binbuddy.canAcknowledge}",
            "onPress": {
              "type": "SendEvent",
              "arguments": [
                "bins-out"
              ]
            },
            "height": 52,
            "marginTop": "${viewport.height < 500 ? 12 : 16}",
            "items": [
              {
                "type": "Frame",
                "width": "100%",
                "height": "100%",
                "backgroundColor": "${payload.binbuddy.canAcknowledge ? '#85efad' : '#2f493b'}",
                "borderRadius": 9,
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.binbuddy.buttonLabel}",
                    "color": "${payload.binbuddy.canAcknowledge ? '#10251a' : '#f1f9f3'}",
                    "fontSize": 21,
                    "fontWeight": "bold",
                    "width": "100%",
                    "height": "100%",
                    "textAlign": "center",
                    "textAlignVertical": "center"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
